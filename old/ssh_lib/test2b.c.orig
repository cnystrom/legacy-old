#include <stdlib.h>
#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include "uio.h"
#include "tty_echo.h"
#include "wlog.h"

void test2_get_line(void);

int
main(void)
{
  int i = 0;

  echo_off();

  wlog_init_file("test2b.log");

  while (1) {
    i++;

    // Tell client exiting after 10 lines
    if (i == 10) {
      wlog("server -> client: exit\n");
      uio_put_line(STDOUT, "exit\n");
      wlog_close();
      echo_on();
      exit (0);
    }
    else { 
      wlog("Server: Welcome to line %d!\n", i);
      uio_put_linef(STDOUT, "Server: Welcome to line %d!\n", i);
    }

    test2_get_line();
  }

  wlog_close();
  echo_on();
  exit(0);
}

void
test2_get_line(void)
{
  byte l[BUFSIZ];

  uio_get_line(STDIN, l, BUFSIZ);
  wlog(l);

  if (strncmp(l, "exit", 4) == 0) {
    wlog_close();
    exit (0);
  }

  if (strncmp(l, "reverse", 7) == 0) {
    uio_get_line(STDIN, l, BUFSIZ);
  }
}

