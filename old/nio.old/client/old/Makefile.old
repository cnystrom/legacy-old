#
#
#

CC =  gcc

BIN = exectest nlogin-txt nlogin

CFLAGS = -I.. -I../nio_lib -I../new_rpc -I/opt/sfw/include -O -Wall -g -DDEBUG -DUNIX
SDL_CFLAGS = -I.. -I../nio_lib -I../new_rpc -I/opt/sfw/include -O -Wall -g -DDEBUG -DUNIX -DSDL `sdl-config --cflags` -I/usr/local/include/SDL

LIBS =  -L/usr/lib -L/opt/sfw/lib -lnsl -lm 
SDL_LIBS =  -L/usr/lib -L/opt/sfw/lib -lnsl -lm `sdl-config --libs` -lSDL_ttf -lSDL_image

NRPC_LIB = ../new_rpc/new_rpc.a

NIO_LIB = ../nio_lib/nio_lib.a

OBJS = rexec.o driver.o file_xfr.o playfile.o playlib.o 

TXT_OBJS = txtloop.o txtmain.o txtrpc.o txtterm.o

SDL_OBJS = loop.o main.o nio_sdl.o sdl_font.o sdl_screen.o sdl_text.o sdl_mouse.o sdl_keyb.o rpc.o term.o SDL_prim.o

all:		$(BIN)

nlogin-txt:		$(OBJS) $(TXT_OBJS)
		$(CC) -o $@ $(TXT_OBJS) $(OBJS) $(NRPC_LIB) $(NIO_LIB) $(LIBS)

nlogin:		$(OBJS) loop.c main.c nio_sdl.c nio_sdl.h
		$(CC) $(SDL_CFLAGS) -c loop.c main.c nio_sdl.c sdl_font.c sdl_screen.c sdl_text.c sdl_mouse.c sdl_keyb.c rpc.c term.c SDL_prim.c
		$(CC) -o $@ $(SDL_OBJS) $(OBJS) $(NRPC_LIB) $(NIO_LIB) $(SDL_LIBS)

exectest:	$(OBJS) exectest.o
		$(CC) -o $@ $(NRPC_LIB) rexec.o exectest.o $(LIBS)

rpc.o:		rpc.c rpc.h
		$(CC) $(SDL_CFLAGS) -c rpc.c

txtrpc.o: rpc.c rpc.h
	$(CC) $(CFLAGS) -c rpc.c
	mv rpc.o txtrpc.o

txtloop.o: loop.c
	$(CC) $(CFLAGS) -c loop.c	
	mv loop.o txtloop.o

txtmain.o: main.c
	$(CC) $(CFLAGS) -c main.c
	mv main.o txtmain.o

txtterm.o: term.c
	$(CC) $(CFLAGS) -c term.c
	mv term.o txtterm.o

rexec.o:	rexec.c rexec.h
		$(CC) $(CFLAGS) -c rexec.c

exectest.o:	exectest.c
		$(CC) $(CFLAGS) -c exectest.c

install:

clean:
		rm -f *.o $(BIN) core

